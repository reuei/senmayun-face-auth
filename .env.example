# 森码云实人认证系统 - 环境配置示例
# 复制此文件为 .env 并修改配置

# ============================================
# 应用配置
# ============================================
APP_DEBUG = false
APP_HOST = 

# ============================================
# 数据库配置
# ============================================
DATABASE_TYPE = mysql
DATABASE_HOSTNAME = 127.0.0.1
DATABASE_DATABASE = senma_face_auth
DATABASE_USERNAME = root
DATABASE_PASSWORD = 
DATABASE_HOSTPORT = 3306
DATABASE_CHARSET = utf8mb4
DATABASE_PREFIX = sm_

# ============================================
# 缓存配置
# ============================================
CACHE_DRIVER = file

# Redis配置（使用redis缓存时配置）
REDIS_HOST = 127.0.0.1
REDIS_PORT = 6379
REDIS_PASSWORD = 
REDIS_SELECT = 0

# ============================================
# API通道配置
# ============================================
# 腾讯云慧眼
TENCENT_SECRET_ID = 
TENCENT_SECRET_KEY = 
TENCENT_RULE_ID = 

# 百度AI
BAIDU_APP_ID = 
BAIDU_API_KEY = 
BAIDU_SECRET_KEY = 

# Azure Face
AZURE_SUBSCRIPTION_KEY = 
AZURE_ENDPOINT = 

# Face++
FACEPP_API_KEY = 
FACEPP_API_SECRET = 
FACEPP_API_URL = https://api-cn.faceplusplus.com

# ============================================
# 魔方财务对接
# ============================================
MOFANG_API_URL = 
MOFANG_API_USERNAME = 
MOFANG_API_KEY = 
MOFANG_CALLBACK_SECRET = 

# ============================================
# 系统安全
# ============================================
JWT_SECRET = change_this_to_a_random_string
API_RATE_LIMIT = 100
