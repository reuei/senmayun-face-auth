{
    "name": "senmayun/face-auth",
    "description": "森码云实人认证系统 - SaaS化人脸核身平台",
    "type": "project",
    "keywords": ["face-auth", "liveness", "face-recognition", "mofang", "senmayun"],
    "homepage": "https://face.builds.codes",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "森码云",
            "email": "support@builds.codes",
            "homepage": "https://www.builds.codes"
        }
    ],
    "require": {
        "php": ">=8.1",
        "topthink/framework": "^8.0",
        "topthink/think-orm": "^3.0",
        "topthink/think-multi-app": "^1.0",
        "topthink/think-view": "^2.0",
        "topthink/think-captcha": "^3.0",
        "firebase/php-jwt": "^6.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app/",
            "extend\\": "extend/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "@php think service:discover"
        ],
        "test": "phpunit",
        "stan": "phpstan analyse app/ --level=6"
    }
}
